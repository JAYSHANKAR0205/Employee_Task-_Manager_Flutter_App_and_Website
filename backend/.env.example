# ==========================================
# Backend Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit your real .env file to version control!
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB)
# Local: mongodb://localhost:27017/registration_db
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/registration_db

# Security & Authentication (Generate strong, random 256-bit secrets)
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_change_in_production
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_change_in_production
ENCRYPTION_SECRET=your_symmetric_encryption_key_change_in_production

# Email Service (Nodemailer / Gmail SMTP)
# For Gmail, generate an App Password from your Google Account security settings
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_gmail_app_password

# Cloudinary Storage (For file/image attachments and profile pictures)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Twilio SMS / OTP Service (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Admin Seed Account (Optional for scripts/createAdmin.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeStrongPassword123!
