# ==========================================
# Frontend Environment Configuration Template
# Copy this file to .env or .env.local and fill in your values
# DO NOT commit your real .env file to version control!
# Note: Variables prefixed with VITE_ are exposed to the browser client bundle.
# Never store confidential private keys or backend service passwords here!
# ==========================================

# Backend API URL
VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID (Optional)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Payload Encryption Secret (Must match backend ENCRYPTION_SECRET)
VITE_ENCRYPTION_SECRET=your_symmetric_encryption_key_change_in_production
